[Unit]
Description=Update only the dedicated portfolio blog CMS container
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=rp4
Group=rp4
SupplementaryGroups=docker
WorkingDirectory=/home/rp4/portfolio-blog-cms/ops/cms
ExecStart=/usr/bin/env node /home/rp4/portfolio-blog-cms/ops/cms/update-cms.mjs
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/rp4/portfolio-blog-cms/ops/cms
PrivateTmp=true
TimeoutStartSec=8min
